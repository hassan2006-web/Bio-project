                continue

            chains = get_all_chains(struct)
            chains_dict[p['prefix']] = chains
            if chains:
                selected_chain = st.selectbox(
                    f"اختر السلسلة - {p['label']}",
                    options=chains,
                    key=f"{p['prefix']}_chain_sel"
