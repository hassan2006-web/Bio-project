                    pdb_input = st.text_input(
                        "كود PDB:",
                        key=f"{p['prefix']}_id_in",
                        placeholder="مثال: 2HHB"
                    ).strip().upper()

                if st.button(f"تحميل {p['label']}", key=f"btn_{p['prefix']}"):
                    with st.spinner('جاري التحميل...'):
                        data = fetch_pdb_data(pdb_input)
