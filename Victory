                if sel_mut != "الكل":
                    parts     = sel_mut.split(" ")
                    focus_mut = {'resi': parts[1], 'chain': parts[3].replace(")", "")}

            if show_mutations:
                mutations_to_show = highlight
            else:
                mutations_to_show = None

            view_html = render_protein_3d(
                pdb_data,
                bg_color=p['bg'],
                style_type=view_style,
                show_surface=show_surf,
                surface_opacity=surface_op,
                mutations=mutations_to_show,
                mut_color=m_color,
                zoom_to_mutations=zoom_mutations,
                focus_mut=focus_mut,
                keep_hetatm=keep_hetatm
