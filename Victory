                            st.session_state.pop(f"focus_{p['prefix']}", None)
                            
                            # تحميل السليم تلقائياً إذا تم تحميل المصاب
                            if p['prefix'] == 'm':
                                h_id = st.session_state.get('h_id_in', '').upper().strip()
