                        s1.metric("متوسط المجاورين",    round(df_res['عدد المجاورين'].mean(), 1))
                        s2.metric("أكثر موضع ازدحاماً", int(df_res.loc[df_res['عدد المجاورين'].idxmax(), 'Residue Num']))
                        s3.metric("أقل موضع ازدحاماً",  int(df_res.loc[df_res['عدد المجاورين'].idxmin(), 'Residue Num']))

                        csv_data = df_res.to_csv(index=False).encode('utf-8')
                        st.download_button(
                            label="⬇️ تنزيل بصيغة CSV",
                            data=csv_data,
                            file_name=f"full_analysis_{pdb_id_key}_chain_{results_chain}.csv",
                            mime="text/csv",
                            key=f"dl_csv_{p['prefix']}"
                        )
                else:
                    st.warning("لم تُعثر على نتائج للتحليل")

    # ============================
    # قسم المقارنة
    # ============================
    h_chain = st.session_state.get("h_selected_chain")
    m_chain = st.session_state.get("m_selected_chain")

    if 'h' in structures and 'm' in structures and structures['h'] and structures['m'] and h_chain and m_chain:
        h_seq = get_protein_sequence(structures['h'], h_chain)
        m_seq = get_protein_sequence(structures['m'], m_chain)

        if h_seq and m_seq:
            df_h = pd.DataFrame(h_seq).rename(columns={'الحمض الأميني': 'السليم'})
            df_m = pd.DataFrame(m_seq).rename(columns={'الحمض الأميني': 'المصاب'})
            df_compare = pd.merge(df_h, df_m, on='رقم البقية', how='outer').sort_values('رقم البقية')
            df_compare = df_compare.astype(object).fillna('-')
            df_compare['تغيّر؟'] = df_compare.apply(
                lambda row: '🔴 طفرة' if row['السليم'] != row['المصاب'] else '🟢 محافظ', axis=1
            )
            df_compare = df_compare[['رقم البقية', 'السليم', 'المصاب', 'تغيّر؟']]

            def highlight_diff(row):
                if row['السليم'] != row['المصاب']:
                    return ['background-color: #c62828; color: white'] * len(row)
                return [''] * len(row)

            with st.expander("📋 الجدول الكامل"):
                st.dataframe(df_compare.style.apply(highlight_diff, axis=1),
                             use_container_width=True, hide_index=True)
        else:
            st.warning("لم يتم العثور على تسلسل في إحدى السلسلتين المختارتين.")

        # ── Alignment ──
        st.divider()
        st.header(f"🧬 Alignment بين السليم والمصاب ({align_mode.capitalize()} Alignment)")

        if h_seq and m_seq:
            h_seq_str = "".join([AA_3TO1.get(r['الحمض الأميني'], 'X') for r in h_seq])
            m_seq_str = "".join([AA_3TO1.get(r['الحمض الأميني'], 'X') for r in m_seq])

            aln_text, score, aln1, aln2 = get_alignment(h_seq_str, m_seq_str, mode=align_mode)
            matches = sum(a == b and a != '-' for a, b in zip(aln1, aln2))
            if len(aln1) > 0:
                identity = matches / len(aln1) * 100
            else:
                identity = 0

            sc1, sc2, sc3 = st.columns(3)
            sc1.metric("Alignment Score", score)
            sc2.metric("Identity %", f"{identity:.2f}%")
            sc3.metric("فرق الطول", abs(len(h_seq_str) - len(m_seq_str)))

            st.markdown("### 🧬 مقارنة التسلسل (Alignment)")
            st.code(aln_text, language='text')
        else:
            st.warning("لا يمكن إجراء Alignment لأن أحد التسلسلين غير موجود.")


if __name__ == "__main__":
    main()
