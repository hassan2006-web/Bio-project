    m_chain = st.session_state.get('m_selected_chain')
    h_struct = structures.get('h')
    m_struct = structures.get('m')

    if h_struct and m_struct and h_chain and m_chain:
        h_seq = get_protein_sequence(h_struct, h_chain)
        m_seq = get_protein_sequence(m_struct, m_chain)
        if h_seq and m_seq:
            dict_h = {r['رقم البقية']: r['الحمض الأميني'] for r in h_seq}
            dict_m = {r['رقم البقية']: r['الحمض الأميني'] for r in m_seq}
            mutations_m = []
            mutations_h = []
            for res_num in set(dict_h) | set(dict_m):
                if dict_h.get(res_num) != dict_m.get(res_num):
                    if dict_m.get(res_num):
                        mutations_m.append({'resi': str(res_num), 'chain': str(m_chain)})
                    if dict_h.get(res_num):
                        mutations_h.append({'resi': str(res_num), 'chain': str(h_chain)})
            if mutations_m:
                highlight_sele_m = mutations_m
            else:
                highlight_sele_m = None
            if mutations_h:
                highlight_sele_h = mutations_h
            else:
                highlight_sele_h = None

    # ── العرض ثلاثي الأبعاد والتحليل ──
    for i, p in enumerate(proteins):
        current_col = v_col1 if i == 0 else v_col2
        with current_col:
            pdb_data = st.session_state.get(f"{p['prefix']}_pdb")
            struct = structures.get(p['prefix'])
            selected_chain = st.session_state.get(f"{p['prefix']}_selected_chain")
            chains         = chains_dict.get(p['prefix'])

            if not pdb_data or not struct or not selected_chain:
                continue

            if p['prefix'] == 'm':
                highlight = highlight_sele_m
                m_color = '#F44336' # Red for mutated
                mut_list = highlight_sele_m
            else:
                highlight = highlight_sele_h
                m_color = '#4CAF50' # Green for healthy
                mut_list = highlight_sele_h

